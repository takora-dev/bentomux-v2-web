# Copy to .env.local. NFR-004.2: a production build fails without a site URL.
# The install commands render as `${NEXT_PUBLIC_SITE_URL}/install.sh` (and
# /install.ps1, /install.cmd),
# which next.config.ts redirects to ../Bentomux-v2/installers/*. Keep this host
# and the one in the application repository's README install block identical:
# BR-005.1 makes the published command a copy of that string, so a mismatch
# ships a command pointing at a host that does not resolve.
NEXT_PUBLIC_SITE_URL=https://bentomux.netlify.app

# Optional. ENT-001.contactEmail is nullable: leave this unset and the mailto:
# links are omitted rather than pointed at an invented address (FR-007.5).
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Optional. The Google Analytics 4 measurement ID (the G- ID from the gtag.js
# snippet). Unset = no analytics script ships and the CSP stays locked to 'self'.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
